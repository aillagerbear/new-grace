# ===========================================
# 소셜 로그인 환경 변수 설정
# ===========================================
# 이 파일을 .env.local로 복사한 후 실제 값을 입력하세요.

# 앱 URL (배포 시 실제 도메인으로 변경)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 데이터베이스 (PostgreSQL)
# 로컬: postgresql://user:password@localhost:5432/dbname
# Cloudtype: Cloudtype에서 제공하는 PostgreSQL 연결 문자열 사용
DATABASE_URL=postgresql://user:password@localhost:5432/grace_church

# Better Auth Secret (세션 암호화용 - 최소 32자 이상의 랜덤 문자열)
# 생성 방법: openssl rand -base64 32
BETTER_AUTH_SECRET=your_random_secret_key_here_change_this_in_production

# ===========================================
# 구글 로그인
# ===========================================
# Google Cloud Console에서 발급:
# https://console.cloud.google.com/apis/credentials
# OAuth 2.0 클라이언트 ID 생성 시:
# - 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===========================================
# 카카오 로그인
# ===========================================
# Kakao Developers에서 발급:
# https://developers.kakao.com/console/app
# 앱 설정 > 카카오 로그인 > 활성화 필요
# Redirect URI: http://localhost:3000/api/auth/callback/kakao

KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# ===========================================
# 네이버 로그인
# ===========================================
# NAVER Developers에서 발급:
# https://developers.naver.com/apps
# 서비스 URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/naver

NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
